{
  "name": "creator-platform-demo",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "http://127.0.0.1:8000/api",
    "NEXT_PUBLIC_GA4_MEASUREMENT_ID": "G-D643PKCHK2"
  },
  "functions": {
    "pages/api/**/*.js": {
      "maxDuration": 30
    }
  }
}
